# Copy to .env.local for local development. Never commit real values (.env* is git-ignored).
# On Vercel, set these in Project → Settings → Environment Variables.

# ── Browser (VITE_ prefix = built into the public JavaScript; only put public values here) ──

# Cloudflare Turnstile SITE key (public by design). Cloudflare dashboard → Turnstile → Add site.
# Test key that always passes: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=""

# ── Server only (used by api/enquiry.ts; never VITE_-prefixed, never sent to the browser) ──

# Google Apps Script web app URL (ends in /exec). See docs/google-apps-script/SETUP.md.
APPS_SCRIPT_URL="https://script.google.com/macros/s/XXXXXXXX/exec"

# Long random secret shared with Apps Script (Script Properties → FORM_SHARED_SECRET).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SHARED_SECRET=""

# Cloudflare Turnstile SECRET key. Test key that always passes: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=""

# Optional: extra sites allowed to post the form, comma-separated (e.g. a custom domain).
# https://teamsamir.com, https://www.teamsamir.com, https://teamsamir.vercel.app and the
# deployment's own Vercel URLs are always allowed.
ALLOWED_ORIGINS=""

# Local testing only: "true" skips Turnstile. Ignored on the production deployment.
TURNSTILE_DISABLED=""
